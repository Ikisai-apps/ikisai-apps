{
  "name": "@ikisai/ui-kit",
  "version": "0.15.0",
  "private": true,
  "description": "Ikisai UI kit: tokens «Taller», componentes base sin framework, barra de estado de sincronización y shell de login",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/styles/tokens.css",
    "./base.css": "./src/styles/base.css",
    "./components.css": "./src/styles/components.css",
    "./ui-kit.css": "./src/styles/ui-kit.css",
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "src",
    "fonts"
  ],
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build:demo": "vite build --config demo/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test -c tests/playwright.config.ts"
  }
}
